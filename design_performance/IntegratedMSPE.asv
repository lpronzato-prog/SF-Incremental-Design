function [ IMSPE ] = IntegratedMSPE( Xn, sequence, theta,p,cov_type)
% function [ IMSPE ] = IntegratedMSPE( Xn, sequence, theta,p,cov_type)
%__________________________________________________________________________
% For Xn (d*n) an n-point design, returns 
% IMSPE of size m = length(sequence), a row vector containing
% the integrated MSPEs of the sequence of designs Xn(:,(1:i1)),...,Xn(:,(1:im)), with 
% [i_1 ... i_m] = sequence = a vector of m consecutive integers in
% {1,...,n}, assuming the variance is 1
% If sequence = k, IMSPE is just the integrated MSPE of Xn(:,(1:k))
% The kernel used is specified by theta,p,cov_type (see calcR_switch.m)
% Requires the kernel to be translation invariant with K(x,x)=1 for all x
% Only applies to tensorised kernels of type Matern12, Matern32, Gaussian.
% Uses calcrx_switch.m
% The integration measure mu is uniform on Xtest,
% a d*Q matrix, for instance of scrambled Sobol' points when the space is [0,1]^d:
%   pSmm = sobolset(d); pSmm = scramble(pSmm,'MatousekAffineOwen');
%   Xtest=(net(pS,2^19))';
% When k_fracfact=k>0, Xtest is completed by a k^d fractional factorial design 
%      (==> k should be kept small form large d, k=2 is reasonable)
% ---> one may use [ Xtest ] = candidate_set( d,q,k,center,Scramble )
%-----
% Author: L. Pronzato, 2022 <pronzato@i3s.unice.fr>
% Permission is granted to use, modify and redistribute this software for 
% non-commercial research and educational purposes only. Commercial use 
% requires prior written permission from the author.
% This MATLAB function is provided in the hope that it will prove useful, 
% but WITHOUT ANY WARRANTY OF FITNESS FOR A PARTICULAR PURPOSE.

% Computes the integrated MSPE of the n point design Xn (a d*n matrix) in [0,1]^d
% sequence is a vector of m integers in {1,...,n}, m<=n
% IMSPE is a row vector of IMSPE for designs Xn(:,(1:i)), i in sequence
%   (if sequence = n, IMSPE is just IMSPE(Xn))
% theta,p,cov_type : kernel parameters and type
% Only applies to translation invariant kernels with K(x,x)=1 for all x
% The kernel must also be tensorised (i.e., TENSORISED=1)
% Matern12, Matern32, Gaussian
% its variance is 1

TENSORISED=1;
nmax=sequence(end);
BK=NaN(1,nmax); % IMSPE=1-BK;
timebar= waitbar(0,'integrated MSPE...'); 
PXn=potential_K2( Xn, theta,p,cov_type,TENSORISED);

X=Xn(:,1);
%Kn=1;
Knm1=1; % --> we shall update Knm1=inv(Kn)

Sn=PXn(1);
    Sn_all=NaN(nmax,nmax);
    Sn_all(1,1)=Sn;
BK(1)=Sn;

for n=1:nmax-1
    waitbar(n/nmax,timebar);
    % choose next point
    Xnp1=Xn(:,n+1);
    knp1=calcrx_switch(X,theta,p,Xnp1,cov_type,TENSORISED);
    snp1=IMSPE_integrals( X,Xnp1, theta,p,cov_type,TENSORISED); snp1=snp1(:);
    Knm1knp1=Knm1*knp1;
    rhonp1=1-knp1'*Knm1knp1;
    BK(n+1)=BK(n)+(Knm1knp1'*Sn*Knm1knp1+PXn(n+1)-2*Knm1knp1'*snp1)/rhonp1;
    
    X=Xn(:,1:n+1);  
    % update Knm1, Sn
    Knm1=[Knm1 + Knm1knp1*Knm1knp1'/rhonp1 -Knm1knp1/rhonp1
          -Knm1knp1'/rhonp1 1/rhonp1];  
    % Sn=[Sn snp1
    %     snp1' PXn(n+1)];      
        Sn_all(1:n+1,1:n+1)=[Sn snp1
                            snp1' PXn(n+1)];
        Sn=Sn_all(1:n+1,1:n+1);
end 
IMSPE=-BK(sequence)+1;
close(timebar) 
end

